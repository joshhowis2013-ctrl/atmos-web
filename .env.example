# Copy this file to .env and fill in a newly rotated DataHub credential.
PORT=3000
MET_OFFICE_WARNINGS_URL=https://replace-with-your-datahub-warnings-endpoint
MET_OFFICE_API_KEY=replace-with-your-new-api-key
# Use the exact header required by your DataHub product.
# Common examples: X-API-Key or Authorization
MET_OFFICE_AUTH_HEADER=X-API-Key
